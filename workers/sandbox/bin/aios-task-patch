#!/usr/bin/env bash
# aios-task-patch <id>
#
# Writes every change of task <id> since its starting commit (git config aios.base) — commits on aios/<id>,
# staged, unstaged and untracked files (respecting .gitignore) — as a binary-safe git patch to
# $WORKSPACE_ROOT/patches/<id>.patch and prints that path. Apply with `git apply` (or `git am` after
# committing). Untracked files are diffed through a throwaway index, so the task's own index is untouched.
set -euo pipefail

here=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
# shellcheck source=../lib/aios/common.sh
source "$here/../lib/aios/common.sh"

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  sed -n '2,8s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"
  exit 0
fi
(($# == 1)) || aios_usage_die "usage: aios-task-patch <id>"
id=$1
aios_require_id "$id"
dir=$(aios_task_dir "$id")
git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || aios_die "task $id not found at $dir"
aios_task_lock "$id"

out_dir=$(aios_workspace_root)/patches
out=$out_dir/$id.patch
mkdir -p -- "$out_dir"
cd -- "$dir"

empty_tree=$(git hash-object -t tree /dev/null)
if ! base=$(git config --get aios.base); then
  # A task without aios.base was started from an empty repository (before it was always recorded): all of
  # its commits are the task's work. HEAD is a fallback for clones made by hand only.
  if git config --get aios.url >/dev/null; then
    base=$empty_tree
  else
    base=$(git rev-parse --verify --quiet 'HEAD^{commit}' || printf '%s\n' "$empty_tree")
  fi
fi
work=$(mktemp -d "${TMPDIR:-/tmp}/aios-patch.XXXXXX")
AIOS_CLEANUP+=("$work")
index=$(git rev-parse --path-format=absolute --git-path index)
[[ ! -f $index ]] || cp -- "$index" "$work/index"

staged=$(mktemp "$out_dir/.$id.patch.XXXXXX")
AIOS_CLEANUP+=("$staged")
GIT_INDEX_FILE=$work/index git add --intent-to-add -- .
GIT_INDEX_FILE=$work/index git -c core.quotePath=false diff --binary --no-color --no-ext-diff --no-textconv \
  --src-prefix=a/ --dst-prefix=b/ "$base" -- >"$staged"
chmod 0644 "$staged"
mv -f -- "$staged" "$out"

files=$(grep -c '^diff --git ' "$out" || true)
aios_log "task $id: $files file(s) changed since ${base:0:12} -> $out"
printf '%s\n' "$out"

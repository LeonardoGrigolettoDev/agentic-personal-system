#!/usr/bin/env bash
# aios-task-destroy <id>
#
# Removes $WORKSPACE_ROOT/tasks/<id> (and leftovers of an interrupted aios-task-start). Idempotent: an
# unknown task is not an error. The patch in $WORKSPACE_ROOT/patches/<id>.patch is the task's result and
# is kept.
set -euo pipefail

here=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
# shellcheck source=../lib/aios/common.sh
source "$here/../lib/aios/common.sh"

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  sed -n '2,6s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"
  exit 0
fi
(($# == 1)) || aios_usage_die "usage: aios-task-destroy <id>"
id=$1
aios_require_id "$id"
dir=$(aios_task_dir "$id")
tasks=$(dirname -- "$dir")
if [[ ! -d $tasks ]]; then
  aios_log "task $id: nothing to destroy"
  exit 0
fi
aios_task_lock "$id"

existed=0
if [[ -e $dir || -L $dir ]]; then existed=1; fi
aios_rm_tree "$dir"
for leftover in "$tasks/.$id.tmp."*; do
  if [[ -e $leftover ]]; then aios_rm_tree "$leftover"; fi
done
if ((existed)); then
  aios_log "task $id: destroyed $dir"
else
  aios_log "task $id: nothing to destroy"
fi

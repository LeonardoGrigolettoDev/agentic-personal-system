#!/usr/bin/env bash
# git credential helper (configured for https://github.com in /etc/gitconfig): answers `get` with the
# GitHub token from $GITHUB_TOKEN (e.g. forwarded by Hermes via SendEnv/AcceptEnv) or, failing that, from
# AIOS_GITHUB_TOKEN_FILE (default /run/aios/github_token: a tmpfs file the entrypoint writes from the
# container's GITHUB_TOKEN, so the token never touches disk). store/erase are no-ops; without a token git
# stays anonymous.
set -euo pipefail

[[ ${1:-} == get ]] || exit 0

protocol="" host=""
while IFS= read -r line && [[ -n $line ]]; do
  case $line in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
  esac
done
[[ $protocol == https && $host == github.com ]] || exit 0

token=${GITHUB_TOKEN:-}
file=${AIOS_GITHUB_TOKEN_FILE:-/run/aios/github_token}
if [[ -z $token && -r $file ]]; then
  token=$(<"$file")
fi
[[ -n $token ]] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"

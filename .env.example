# Copy is created by `make env` (chmod 600). Empty secrets are generated; provider keys you paste by hand.
# Same variable names are used as Railway Variables later (docs/ARCHITECTURE.md §24.8).
TZ=America/Sao_Paulo
RENDER_GID=992
PG_HOST_PORT=5432

# --- postgres (one instance, three DBs: aios, litellm, langfuse) ---
PG_SUPERUSER_PASSWORD=
AIOS_DB_PASSWORD=
AIOS_READER_PASSWORD=
LITELLM_DB_PASSWORD=
LANGFUSE_DB_PASSWORD=

# --- valkey (redis-compatible) ---
REDIS_PASSWORD=

# --- litellm (LITELLM_SALT_KEY can NEVER change after the first key/model is stored - keep .env backed up) ---
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
HERMES_LITELLM_KEY=
DECISION_LITELLM_KEY=
KB_LITELLM_KEY=
EDGE_LITELLM_KEY=
BENCH_LITELLM_KEY=

# --- model providers (leave empty if you don't have one; its deployments are omitted from the rendered config) ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
# Jev (TypeSafe AI "System One" decision model) - https://docs.typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# --- hermes ---
HERMES_TAG=v2026.9.24
HERMES_API_KEY=
HERMES_WEBHOOK_SECRET=
# tenant assumed for chief sessions when the router can't tell (empty = classify, fallback 'shared')
AIOS_DEFAULT_TENANT=
# where cron review outputs go: local | telegram | discord | ... (Hermes --deliver grammar)
AIOS_CRON_DELIVER=local
# /p/<profile>/ API keys (multiplexed gateway): hermes-setup writes each into the profile's .env (bench uses them)
HERMES_API_KEY_ENGINEERING=
HERMES_API_KEY_FINANCE=
HERMES_API_KEY_PROJECTS=
HERMES_API_KEY_PERSONAL=
HERMES_API_KEY_LEARNING=

# --- decision service ---
DECISION_API_KEY=
DECISION_BACKENDS=rules,local
DECISION_THRESHOLD=0.8
DECISION_LOCAL_MODE=logprobs
OLLAMA_DECIDER_MODEL=qwen3:4b-instruct-2507-q4_K_M
OPENAI_DECISIONS_MODEL=gpt-6-luna

# --- knowledge service (container) + kb CLI (host) ---
KNOWLEDGE_API_KEY=
KNOWLEDGE_TENANTS=nitro,pessoal,shared
KB_EMBED_MODEL=embed-local
KB_EMBED_DIM=1024

# --- notifications / messaging (optional) ---
# Telegram: create a bot with @BotFather; TELEGRAM_ALLOWED_USERS = your numeric user id (Hermes allowlist)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_CHAT_ID=
# ntfy.sh (or self-hosted) topic URL for approval/escalation pushes, e.g. https://ntfy.sh/<random-topic>
NTFY_URL=

# --- edge media worker (§22): make edge-up; host commands use the admin key, agents only their tenant's key ---
EDGE_API_KEY=
# tenant:key,... (generated); a Kanban worker gets only the key of its task's tenant (aios plugin)
EDGE_TENANT_KEYS=
MEDIA_RETENTION_DAYS=30
# optional: Hugging Face token for pyannote diarization (build edge with EDGE_EXTRAS=diarize)
HF_TOKEN=

# --- sandbox (Hermes' terminal backend, profile agent) ---
# optional fine-grained, repo-scoped token for private clones (the agent can read it; kept on a tmpfs)
SANDBOX_GITHUB_TOKEN=

# --- langfuse: leave keys empty to disable; cloud (https://cloud.langfuse.com) or self-host (http://langfuse-web:3000) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TAG=4.54.0
NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_ADMIN_EMAIL=
LANGFUSE_ADMIN_PASSWORD=

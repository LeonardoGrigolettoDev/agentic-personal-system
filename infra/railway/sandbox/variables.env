# Railway variables for service "sandbox" (mirrors infra/compose/sandbox.snippet.yaml). sshd :22 is reachable on
# the private network only: never add a TCP proxy or domain. Railway has no file mounts, so railway.json's
# startCommand writes the authorized key and the stable host key from these variables, then runs the image's
# normal entrypoint (tini -> aios-sandbox-entrypoint).
AIOS_SANDBOX_SSH_PUBKEY=${{shared.AIOS_SANDBOX_SSH_PUBKEY}}
AIOS_SANDBOX_HOST_KEY_B64=${{shared.AIOS_SANDBOX_HOST_KEY_B64}}
# skills/knowledge/transcript_to_notes/scripts/edge_pipeline.sh runs in sandbox SSH sessions and defaults to
# http://edge:8080; railway.json's startCommand exports this into the agent's login profile (/etc/profile.d).
AIOS_EDGE_URL=http://${{edge-gw.RAILWAY_PRIVATE_DOMAIN}}:8093
AIOS_CHECK_TIMEOUT=570
AIOS_TASK_CHECK_TIMEOUT=280
AIOS_CLONE_TIMEOUT=900
TZ=${{shared.TZ}}

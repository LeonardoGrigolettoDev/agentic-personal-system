# Railway variables for service "postgres" (paste into the service's Raw Editor). References only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${{shared.PG_SUPERUSER_PASSWORD}}
POSTGRES_DB=postgres
PGDATA=/var/lib/postgresql/data/pgdata
# read by infra/docker/postgres/initdb/01-init.sh on the first boot
AIOS_DB_PASSWORD=${{shared.AIOS_DB_PASSWORD}}
AIOS_READER_PASSWORD=${{shared.AIOS_READER_PASSWORD}}
LITELLM_DB_PASSWORD=${{shared.LITELLM_DB_PASSWORD}}
LANGFUSE_DB_PASSWORD=${{shared.LANGFUSE_DB_PASSWORD}}
# libpq defaults for `railway ssh -s postgres -- psql ...` (local socket). Never set PGHOST/PGHOSTADDR here: the
# image's executable initdb scripts inherit this environment and would dial TCP while the first-boot server
# listens on the socket only (initdb/00-local-socket.sh unsets them as a second guard; make railway-check fails).
PGUSER=postgres
PGPASSWORD=${{shared.PG_SUPERUSER_PASSWORD}}
PGDATABASE=postgres
PGPORT=5432
# read by `railway connect` (credentials and in-container port), never by libpq
DATABASE_URL=postgresql://postgres:${{shared.PG_SUPERUSER_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/postgres
# compose uses shm_size 256mb (HNSW builds); Railway's default is 64 MB
RAILWAY_SHM_SIZE_BYTES=268435456
TZ=UTC

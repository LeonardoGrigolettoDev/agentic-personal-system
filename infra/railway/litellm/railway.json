{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/railway/litellm/Dockerfile",
    "watchPatterns": ["/config/litellm/config.template.yaml", "/infra/scripts/render-litellm-config.py", "/infra/railway/litellm/**",
                      "/infra/railway/lib/maintenance.sh"]
  },
  "deploy": {
    "startCommand": null,
    "healthcheckPath": "/health/liveliness",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "drainingSeconds": 30
  }
}

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/railway/hermes/Dockerfile",
    "watchPatterns": [
      "/tools/hermes-plugin/aios/**",
      "/config/hermes/**",
      "/agents/**",
      "/skills/**",
      "/workflows/**",
      "/infra/hermes/**",
      "/infra/railway/hermes/**",
      "/infra/railway/lib/maintenance.sh"
    ]
  },
  "deploy": {
    "startCommand": null,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "requiredMountPath": "/opt/data",
    "drainingSeconds": 30
  }
}

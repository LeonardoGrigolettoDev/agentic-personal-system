# Railway variables for service "hermes" (mirrors compose.yaml services.hermes.environment).
# No public domain: the API server is full terminal access. Reach it over the tailnet (edge-gw) or `railway ssh`.
PORT=8642
# 1 (shared) until the cutover: the container stays up for the state upload, the gateway does not run
AIOS_MAINTENANCE=${{shared.AIOS_MAINTENANCE}}
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=${{shared.HERMES_API_KEY}}
LITELLM_API_KEY=${{shared.HERMES_LITELLM_KEY}}
HERMES_WEBHOOK_SECRET=${{shared.HERMES_WEBHOOK_SECRET}}
HERMES_LANGFUSE_PUBLIC_KEY=${{shared.LANGFUSE_PUBLIC_KEY}}
HERMES_LANGFUSE_SECRET_KEY=${{shared.LANGFUSE_SECRET_KEY}}
HERMES_LANGFUSE_BASE_URL=${{shared.LANGFUSE_HOST}}
AIOS_DECISION_URL=http://${{decision.RAILWAY_PRIVATE_DOMAIN}}:8080
DECISION_API_KEY=${{shared.DECISION_API_KEY}}
AIOS_KNOWLEDGE_URL=http://${{knowledge.RAILWAY_PRIVATE_DOMAIN}}:8080
KNOWLEDGE_API_KEY=${{shared.KNOWLEDGE_API_KEY}}
AIOS_AGENTS_DIR=/opt/aios/agents
AIOS_DEFAULT_TENANT=
EDGE_TENANT_KEYS=${{shared.EDGE_TENANT_KEYS}}
AIOS_CRON_DELIVER=local
HERMES_API_KEY_ENGINEERING=${{shared.HERMES_API_KEY_ENGINEERING}}
HERMES_API_KEY_FINANCE=${{shared.HERMES_API_KEY_FINANCE}}
HERMES_API_KEY_PROJECTS=${{shared.HERMES_API_KEY_PROJECTS}}
HERMES_API_KEY_PERSONAL=${{shared.HERMES_API_KEY_PERSONAL}}
HERMES_API_KEY_LEARNING=${{shared.HERMES_API_KEY_LEARNING}}
TELEGRAM_BOT_TOKEN=${{shared.TELEGRAM_BOT_TOKEN}}
TELEGRAM_ALLOWED_USERS=${{shared.TELEGRAM_ALLOWED_USERS}}
TERMINAL_SSH_HOST=${{sandbox.RAILWAY_PRIVATE_DOMAIN}}
TERMINAL_SSH_USER=agent
TERMINAL_SSH_PORT=22
TERMINAL_SSH_KEY=/opt/aios/ssh/id_ed25519
AIOS_SANDBOX_SSH_KEY_B64=${{shared.AIOS_SANDBOX_SSH_KEY_B64}}
TZ=${{shared.TZ}}

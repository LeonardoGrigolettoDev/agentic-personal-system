# Railway variables for service "knowledge" (mirrors compose.yaml services.knowledge.environment).
PORT=8080
KNOWLEDGE_API_KEY=${{shared.KNOWLEDGE_API_KEY}}
KNOWLEDGE_TENANTS=nitro,pessoal,shared
KB_DATABASE_URL=postgresql://aios:${{shared.AIOS_DB_PASSWORD}}@${{postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/aios
KB_POOL_MAX=4
LITELLM_BASE_URL=http://${{litellm.RAILWAY_PRIVATE_DOMAIN}}:4000
KB_LITELLM_KEY=${{shared.KB_LITELLM_KEY}}
# The service keeps no files today. Switch to the bucket (STORAGE_BACKEND=s3 + the STORAGE_S3_* below) once the
# knowledge image installs the `s3` extra (boto3); see infra/railway/variables.md.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/storage
STORAGE_S3_BUCKET=${{aios-storage.BUCKET}}
STORAGE_S3_ENDPOINT=${{aios-storage.ENDPOINT}}
STORAGE_S3_REGION=${{aios-storage.REGION}}
STORAGE_S3_ACCESS_KEY_ID=${{aios-storage.ACCESS_KEY_ID}}
STORAGE_S3_SECRET_ACCESS_KEY=${{aios-storage.SECRET_ACCESS_KEY}}

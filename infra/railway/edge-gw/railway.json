{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/railway/edge-gw/Dockerfile",
    "watchPatterns": [
      "/infra/railway/edge-gw/**"
    ]
  },
  "deploy": {
    "startCommand": null,
    "healthcheckPath": null,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "drainingSeconds": 10,
    "requiredMountPath": "/var/lib/tailscale"
  }
}

# Railway variables for service "edge-gw" (Tailscale gateway). Replace `thinkpad` with the ThinkPad's MagicDNS
# name printed by infra/scripts/tailscale-edge.sh. The tailnet ACL decides who may use any of these ports.
TS_AUTHKEY=${{shared.TS_AUTHKEY}}
# node state on the volume: stable name/100.x address; the auth key is used only for the first login
TS_STATE=/var/lib/tailscale/tailscaled.state
TS_HOSTNAME=aios-railway
TS_TAGS=tag:aios-cloud
EDGE_GW_FORWARD=8093=thinkpad:8093,11434=thinkpad:11434
# laptop/phone on the tailnet -> cloud APIs (each still requires its bearer key); delete what you don't use
EDGE_GW_EXPOSE=4000=${{litellm.RAILWAY_PRIVATE_DOMAIN}}:4000,8090=${{decision.RAILWAY_PRIVATE_DOMAIN}}:8080,8092=${{knowledge.RAILWAY_PRIVATE_DOMAIN}}:8080,8642=${{hermes.RAILWAY_PRIVATE_DOMAIN}}:8642

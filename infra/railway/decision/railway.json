{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/railway/decision/Dockerfile",
    "watchPatterns": ["/decision/**", "/config/routing.yaml", "/config/decision/**", "/agents/**", "/infra/railway/decision/**"]
  },
  "deploy": {
    "startCommand": null,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "drainingSeconds": 15
  }
}

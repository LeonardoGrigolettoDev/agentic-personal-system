# Railway variables for service "decision" (mirrors compose.yaml services.decision.environment).
PORT=8080
DATABASE_URL=postgresql://aios:${{shared.AIOS_DB_PASSWORD}}@${{postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/aios?pool_max_conns=5
REDIS_ADDR=${{redis.REDISHOST}}:${{redis.REDISPORT}}
REDIS_PASSWORD=${{redis.REDISPASSWORD}}
REDIS_DB=1
DECISION_API_KEY=${{shared.DECISION_API_KEY}}
# with the ThinkPad asleep the local backend is unreachable; add jev once TYPESAFE_API_KEY is set
DECISION_BACKENDS=rules,local
DECISION_THRESHOLD=0.8
DECISION_LOCAL_MODE=logprobs
DECISION_RULES_FILE=/etc/decision/rules.yaml
DECISION_REQUIRED_MIGRATION=006_decision_ledger
DECISION_POLICY_FILE=/etc/aios/routing.yaml
DECISION_AGENTS_DIR=/etc/aios/agents
BUDGET_TZ=${{shared.TZ}}
LITELLM_BASE_URL=http://${{litellm.RAILWAY_PRIVATE_DOMAIN}}:4000
LITELLM_API_KEY=${{shared.DECISION_LITELLM_KEY}}
# host Ollama on the ThinkPad, reached through the Tailscale gateway
OLLAMA_BASE_URL=http://${{edge-gw.RAILWAY_PRIVATE_DOMAIN}}:11434
OLLAMA_DECIDER_MODEL=qwen3:4b-instruct-2507-q4_K_M
TYPESAFE_API_KEY=${{shared.TYPESAFE_API_KEY}}
JEV_MODEL=jev-latest
OPENAI_API_KEY=${{shared.OPENAI_API_KEY}}
OPENAI_DECISIONS_MODEL=gpt-6-luna
HERMES_WEBHOOK_SECRET=${{shared.HERMES_WEBHOOK_SECRET}}
TELEGRAM_BOT_TOKEN=${{shared.TELEGRAM_BOT_TOKEN}}
TELEGRAM_CHAT_ID=${{shared.TELEGRAM_CHAT_ID}}
NTFY_URL=${{shared.NTFY_URL}}

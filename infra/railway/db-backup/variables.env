# Railway variables for the cron service "db-backup" (06:00 UTC = 03:00 America/Sao_Paulo, like the local timer).
PGHOST=${{postgres.RAILWAY_PRIVATE_DOMAIN}}
PGPORT=5432
PGUSER=postgres
PGPASSWORD=${{shared.PG_SUPERUSER_PASSWORD}}
BACKUP_DATABASES=aios,litellm
BACKUP_RETENTION_DAYS=14
BACKUP_REMOTE=aios:${{aios-backups.BUCKET}}/postgres
# rclone remote "aios" from variables only (no rclone.conf). Point these at R2 instead to keep the copy off Railway.
RCLONE_CONFIG_AIOS_TYPE=s3
RCLONE_CONFIG_AIOS_PROVIDER=Other
# rclone's "Other" provider defaults to path-style requests; Railway Buckets use virtual-hosted style. Set true
# for a bucket whose Credentials tab says "path", and when pointing this remote at R2 (rclone's R2 default).
RCLONE_CONFIG_AIOS_FORCE_PATH_STYLE=false
RCLONE_CONFIG_AIOS_ENDPOINT=${{aios-backups.ENDPOINT}}
RCLONE_CONFIG_AIOS_REGION=${{aios-backups.REGION}}
RCLONE_CONFIG_AIOS_ACCESS_KEY_ID=${{aios-backups.ACCESS_KEY_ID}}
RCLONE_CONFIG_AIOS_SECRET_ACCESS_KEY=${{aios-backups.SECRET_ACCESS_KEY}}

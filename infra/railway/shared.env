# Railway SHARED variables (Project Settings -> Shared Variables), referenced as ${{shared.NAME}}.
# Values never live in git. Format: NAME=<default>  # secret|plain: note
#   secret -> copy the value from the local .env at cutover (railway-plan shows which ones .env has)
#   plain  -> the default after '=' is used unless .env says otherwise
# LITELLM_SALT_KEY must be byte-identical to the local one: it decrypts what the litellm DB already stores.

# --- postgres roles (the cloud DB keeps the local passwords unless you rotate both sides) ---
PG_SUPERUSER_PASSWORD=          # secret: postgres superuser (initdb + db-backup + migration)
AIOS_DB_PASSWORD=               # secret: role aios (decision, knowledge)
AIOS_READER_PASSWORD=           # secret: role aios_reader (read-only reporting)
LITELLM_DB_PASSWORD=            # secret: role litellm
LANGFUSE_DB_PASSWORD=           # secret: role langfuse (created by initdb even when Langfuse Cloud is used)

# --- litellm ---
LITELLM_MASTER_KEY=             # secret: admin key; only the litellm service gets it
LITELLM_SALT_KEY=               # secret: NEVER changes after the first stored key (copy from .env)
HERMES_LITELLM_KEY=             # secret: virtual key (lives in the migrated litellm DB)
DECISION_LITELLM_KEY=           # secret: virtual key
KB_LITELLM_KEY=                 # secret: virtual key

# --- service bearer keys ---
HERMES_API_KEY=                 # secret: Hermes API server (full terminal access)
HERMES_WEBHOOK_SECRET=          # secret: HMAC for Hermes webhooks -> decision /v1/hermes-events
DECISION_API_KEY=               # secret
KNOWLEDGE_API_KEY=              # secret
EDGE_TENANT_KEYS=               # secret: tenant:key,... edge keys handed to Kanban workers (admin EDGE_API_KEY stays local)
HERMES_API_KEY_ENGINEERING=     # secret: /p/engineering API key (written into the profile .env by setup.py)
HERMES_API_KEY_FINANCE=         # secret
HERMES_API_KEY_PROJECTS=        # secret
HERMES_API_KEY_PERSONAL=        # secret
HERMES_API_KEY_LEARNING=        # secret

# --- model providers (empty = provider omitted from the rendered LiteLLM config) ---
ANTHROPIC_API_KEY=              # secret
OPENROUTER_API_KEY=             # secret
OPENAI_API_KEY=                 # secret
MOONSHOT_API_KEY=               # secret
DEEPSEEK_API_KEY=               # secret
TYPESAFE_API_KEY=               # secret: Jev

# --- observability (Langfuse Cloud by default) ---
LANGFUSE_HOST=https://cloud.langfuse.com  # plain: Langfuse Cloud (or a self-hosted URL)
LANGFUSE_PUBLIC_KEY=            # secret
LANGFUSE_SECRET_KEY=            # secret

# --- notifications / messaging ---
TELEGRAM_BOT_TOKEN=             # secret
TELEGRAM_ALLOWED_USERS=         # secret: numeric Telegram user ids (Hermes allowlist)
TELEGRAM_CHAT_ID=               # secret
NTFY_URL=                       # secret: the topic URL is the capability

# --- Railway-only (new) ---
TS_AUTHKEY=                     # secret: Tailscale auth key for edge-gw: tag:aios-cloud, pre-approved, single-use (first login)
AIOS_SANDBOX_SSH_KEY_B64=       # secret: base64 -w0 data/sandbox/keys/id_ed25519 (Hermes -> sandbox SSH)
AIOS_SANDBOX_SSH_PUBKEY=        # plain: contents of data/sandbox/keys/id_ed25519.pub (sandbox authorized_keys)
AIOS_SANDBOX_HOST_KEY_B64=      # secret: base64 -w0 of a dedicated ed25519 host key (stable known_hosts across deploys)

# --- plain ---
TZ=America/Sao_Paulo            # plain: user timezone (budgets, cron, logs)
AIOS_MAINTENANCE=1              # plain: 1 = litellm and hermes boot in maintenance mode (container up, no DB writes, no gateway) until RUNBOOK §9.3 step 7 sets 0
